# Copie para .env (o Bun carrega sozinho) e preencha só o que você usa.
# Nada aqui é obrigatório para abrir o painel: sem chave o app funciona,
# só não gera roteiro/voz/render completo.
#
# Também dá para colar as chaves pelo painel: aba Créditos (grava em
# ~/.config/studio/keys.json com permissão 600).

# roteiro (obrigatório para gerar)
OPENROUTER_API_KEY=

# alternativa de roteiro/LLM (opcional)
MAGMAROUTER_API_KEY=

# voz (obrigatório para narração)
ELEVENLABS_API_KEY=

# banco de vídeos stock (obrigatório para b-roll do fetch-pexels)
PEXELS_API_KEY=

# Kling Avatar (opcional, formatos de avatar)
KIE_API_KEY=

# opcional
GEMINI_API_KEY=

# porta do servidor (padrão 4599)
PORT=4599

# onde os vídeos renderizados ficam (padrão ~/Movies/studio)
# STUDIO_FILES=~/Movies/studio
